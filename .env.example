# Database Configuration
POSTGRES_USER=medtimeline
POSTGRES_PASSWORD=medtimeline_secret_pass
POSTGRES_DB=medtimeline_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://medtimeline:medtimeline_secret_pass@db:5432/medtimeline_db

# Redis Queue Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# MinIO / Object Storage Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret
MINIO_BUCKET_NAME=medtimeline-docs
MINIO_SECURE=false

# LLM & Extraction Settings
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
CONFIDENCE_THRESHOLD_CRITICAL=0.85
CONFIDENCE_THRESHOLD_HIGH=0.80
CONFIDENCE_THRESHOLD_MEDIUM=0.70

# Auth JWT Settings
JWT_SECRET=super_secret_jwt_key_medtimeline_2026_xyz
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload Constraints
MAX_UPLOAD_SIZE_MB=25
